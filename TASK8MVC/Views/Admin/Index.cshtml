@using Microsoft.AspNetCore.Identity
<h2>Manage Users</h2>
<table class="table">
    <thead><tr><th>Email</th><th>Roles</th><th></th></tr></thead>
    <tbody>
    @foreach (IdentityUser user in ViewBag.Users)
    {
        <tr><td>@user.Email</td><td>@ViewBag.UserRoles[user.Id]</td><td>
            <a asp-action="Edit" asp-route-id="@user.Id">Change Role</a>
            <a asp-action="Delete" asp-route-id="@user.Id">Delete</a>
        </td></tr>
    }
    </tbody>
</table>